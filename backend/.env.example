# Copy to backend/.env and fill in. Restart the server after any change.

# ---------------------------------------------------------------------------
# AI — Gemini (free key, no credit card needed)
# Get one at: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
# This file is COMMITTED to git — never put a real key here. It belongs in
# backend/.env, which is gitignored.
GEMINI_API_KEY=
# gemini-2.5-flash is retired for new keys. Use a current flash model, or
# gemini-flash-latest to always track the newest.
GEMINI_MODEL=gemini-3.6-flash

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5050
CORS_ORIGIN=http://localhost:5273

# ---------------------------------------------------------------------------
# Storage. First match wins:
#   MONGODB_URI set → MongoDB Atlas (free M0 cluster)
#   DATA_FILE set   → JSON file on disk (default — no setup needed)
#   neither         → in memory, wiped on restart
# ---------------------------------------------------------------------------
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=sheshieldai
DATA_FILE=./.data/sessions.json

# Anonymous sessions are deleted after this many days.
RETENTION_DAYS=7
