# Copy to backend/.env and fill in. Restart the server after any change.

# ---------------------------------------------------------------------------
# AI provider
#
# This file is COMMITTED to git — never put a real key here. Keys belong in
# backend/.env, which is gitignored.
#
# Set either key. Whichever is present wins (Groq first); set AI_PROVIDER to
# force one. With neither, the app runs on the offline heuristic engine, which
# is a supported mode — every feature still works.
# ---------------------------------------------------------------------------
# AI_PROVIDER=groq

# Groq — free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini — free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-2.5-flash is retired for new keys. Use a current flash model, or
# gemini-flash-latest to always track the newest.
GEMINI_MODEL=gemini-3.6-flash

# ---------------------------------------------------------------------------
# Image analysis (the Analyze page's screenshot upload)
#
# Screenshots are read with OCR and the text goes through the ordinary pipeline,
# because the default analysis model is text-only. Nothing here is required.
#
# Set VISION_MODEL to a multimodal Groq model to have it read the image instead
# of Tesseract — the pipeline, the scoring, and the stored shape are unchanged,
# and OCR remains the fallback if the model is unreachable.
# ---------------------------------------------------------------------------
# VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# MAX_IMAGE_BYTES=8388608
# OCR_LANGUAGES=eng
# OCR_CACHE_DIR=./.data/tessdata

# ---------------------------------------------------------------------------
# Server
#
# CORS_ORIGIN adds to the local dev origins (5273 and 5274) in development, and
# replaces them in production. Comma-separated.
# ---------------------------------------------------------------------------
PORT=5050
# CORS_ORIGIN=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# Storage. First match wins:
#   MONGODB_URI set → MongoDB Atlas (free M0 cluster)
#   DATA_FILE set   → JSON file on disk (default — no setup needed)
#   neither         → in memory, wiped on restart
# ---------------------------------------------------------------------------
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=sheshieldai
DATA_FILE=./.data/sessions.json

# Anonymous sessions are deleted after this many days.
RETENTION_DAYS=7
