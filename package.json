{
  "name": "sheshieldai",
  "version": "1.0.0",
  "private": true,
  "description": "SheShield AI — AI-powered platform for detecting, supporting, and reporting cyber harassment against women",
  "workspaces": [
    "database",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c magenta,cyan \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "start": "npm start --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "test": "npm test --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
