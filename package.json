{
  "name": "sheshieldai",
  "version": "1.0.0",
  "private": true,
  "description": "SheShield AI — AI-powered platform for detecting, supporting, and reporting cyber harassment against women",
  "workspaces": [
    "database",
    "backend",
    "frontend",
    "social"
  ],
  "scripts": {
    "dev": "node scripts/check-ports.mjs 5050 5273 && concurrently --kill-others-on-fail -n backend,frontend -c magenta,cyan \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:all": "node scripts/check-ports.mjs 5050 5273 5274 && concurrently --kill-others-on-fail -n backend,frontend,social -c magenta,cyan,yellow \"npm:dev:backend\" \"npm:dev:frontend\" \"npm:dev:social\"",
    "check:ports": "node scripts/check-ports.mjs 5050 5273 5274",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:social": "npm run dev --workspace=social",
    "start": "npm start --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "build:social": "npm run build --workspace=social",
    "test": "npm test --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
